# Copy to .env (or .env.local) and adjust. Never commit the real file.
# Base URL of the Express API, including the /api prefix.
VITE_API_BASE_URL=http://localhost:5000/api

# Display name used in the browser title, login screen and sidebar.
VITE_APP_NAME=49Stores

# Currency / locale used for prices, receipts and labels (Intl codes).
VITE_CURRENCY=INR
VITE_LOCALE=en-IN
