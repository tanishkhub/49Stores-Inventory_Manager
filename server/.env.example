# Copy to .env and adjust. Never commit the real .env.
PORT=5000
MONGODB_URI=mongodb://localhost:27017/inventory_poc
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-separated list of browser origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Initial Super Admin created by `npm run seed` (only used when the user does not exist yet).
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@inventory.local
SEED_ADMIN_PASSWORD=Admin@12345

# Product image storage (optional): browser uploads straight to Cloudinary via a signed
# /api/uploads/sign endpoint. Leave blank to fall back to base64-in-Mongo image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
